    {
      "kind": "model",
      "path": "northwind/sales_lines.yml",
      "content": "cubes:\n  - name: sales_lines\n    sql_table: analytics.sales_lines\n    title: Sales lines\n    description: One row per order line (Superset dataset analytics.sales_lines).\n\n    dimensions:\n      - name: line_id\n        sql: \"{CUBE}.order_id::text || '-' || {CUBE}.product_id::text\"\n        type: string\n        primary_key: true\n        public: false\n      - name: order_id\n        title: Order ID\n        sql: order_id\n        type: number\n        format: id\n      - name: order_date\n        title: Order Date\n        sql: order_date\n        type: time\n      - name: order_year\n        title: Order Year\n        sql: order_year\n        type: number\n        format: id\n      - name: order_quarter\n        title: Order Quarter\n        sql: order_quarter\n        type: string\n      - name: customer_id\n        title: Customer ID\n        sql: customer_id\n        type: string\n      - name: customer\n        title: Customer\n        sql: customer\n        type: string\n      - name: customer_city\n        title: Customer City\n        sql: customer_city\n        type: string\n      - name: customer_country\n        title: Customer Country\n        sql: customer_country\n        type: string\n      - name: customer_country_iso3\n        title: Customer Country ISO3\n        sql: customer_country_iso3\n        type: string\n      - name: employee\n        title: Employee\n        sql: employee\n        type: string\n      - name: shipper\n        title: Shipper\n        sql: shipper\n        type: string\n      - name: product_id\n        title: Product ID\n        sql: product_id\n        type: number\n        format: id\n      - name: product_name\n        title: Product Name\n        sql: product_name\n        type: string\n      - name: category\n        title: Category\n        sql: category\n        type: string\n      - name: supplier\n        title: Supplier\n        sql: supplier\n        type: string\n      - name: supplier_country\n        title: Supplier Country\n        sql: supplier_country\n        type: string\n      - name: unit_price\n        title: Unit Price\n        sql: unit_price\n        type: number\n        format: currency\n      - name: quantity\n        title: Quantity\n        sql: quantity\n        type: number\n      - name: discount\n        title: Discount\n        sql: discount\n        type: number\n        format: percent\n\n    measures:\n      - name: revenue\n        title: Revenue\n        sql: revenue\n        type: sum\n        format: currency\n      - name: orders\n        title: Orders\n        sql: order_id\n        type: count_distinct\n      - name: customers\n        title: Customers\n        sql: customer_id\n        type: count_distinct\n      - name: avg_order_value\n        title: Avg Order Value\n        sql: \"SUM({CUBE}.revenue) / NULLIF(COUNT(DISTINCT {CUBE}.order_id), 0)\"\n        type: number\n        format: currency\n      - name: units_sold\n        title: Units Sold\n        sql: quantity\n        type: sum\n      - name: discount_amount\n        title: Discounts Given\n        sql: discount_amount\n        type: sum\n        format: currency\n      - name: gross_amount\n        title: Gross Amount\n        sql: gross_amount\n        type: sum\n        format: currency\n      - name: discount_rate\n        title: Discount Rate\n        sql: \"SUM({CUBE}.discount_amount) / NULLIF(SUM({CUBE}.gross_amount), 0)\"\n        type: number\n        format: percent\n      - name: count\n        title: Row Count\n        type: count"
    },
