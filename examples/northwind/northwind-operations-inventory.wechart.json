    {
      "kind": "model",
      "path": "northwind/order_summary.yml",
      "content": "cubes:\n  - name: order_summary\n    sql_table: analytics.order_summary\n    title: Order summary\n    description: One row per order (Superset dataset analytics.order_summary).\n\n    dimensions:\n      - name: order_id\n        title: Order ID\n        sql: order_id\n        type: number\n        primary_key: true\n        public: true\n        format: id\n      - name: order_date\n        title: Order Date\n        sql: order_date\n        type: time\n      - name: required_date\n        title: Required Date\n        sql: required_date\n        type: time\n      - name: shipped_date\n        title: Shipped Date\n        sql: shipped_date\n        type: time\n      - name: order_year\n        title: Order Year\n        sql: order_year\n        type: number\n        format: id\n      - name: customer\n        title: Customer\n        sql: customer\n        type: string\n      - name: customer_country\n        title: Customer Country\n        sql: customer_country\n        type: string\n      - name: employee\n        title: Employee\n        sql: employee\n        type: string\n      - name: shipper\n        title: Shipper\n        sql: shipper\n        type: string\n      - name: ship_city\n        title: Ship City\n        sql: ship_city\n        type: string\n      - name: ship_country\n        title: Ship Country\n        sql: ship_country\n        type: string\n      - name: ship_country_iso3\n        title: Ship Country ISO3\n        sql: ship_country_iso3\n        type: string\n      - name: ship_status\n        title: Ship Status\n        sql: ship_status\n        type: string\n      - name: days_to_ship\n        title: Days to Ship\n        sql: days_to_ship\n        type: number\n      - name: freight_amount\n        title: Freight Amount\n        sql: freight\n        type: number\n        format: currency\n      - name: line_items\n        title: Line Items\n        sql: line_items\n        type: number\n      - name: units\n        title: Units\n        sql: units\n        type: number\n      - name: order_revenue_amount\n        title: Order Revenue Amount\n        sql: order_revenue\n        type: number\n        format: currency\n\n    measures:\n      - name: order_revenue\n        title: Revenue\n        sql: order_revenue\n        type: sum\n        format: currency\n      - name: freight\n        title: Freight\n        sql: freight\n        type: sum\n        format: currency\n      - name: avg_days_to_ship\n        title: Avg Days to Ship\n        sql: days_to_ship\n        type: avg\n      - name: max_days_to_ship\n        title: Days to Ship\n        description: The longest days to ship, over shipped orders only (Superset's box plot metric, MAX(days_to_ship) WHERE shipped_date IS NOT NULL).\n        sql: days_to_ship\n        type: max\n        filters:\n          - sql: \"{CUBE}.shipped_date IS NOT NULL\"\n      - name: late_rate\n        title: Late Shipment Rate\n        sql: \"SUM(CASE WHEN {CUBE}.ship_status = 'Late' THEN 1 ELSE 0 END)::float / NULLIF(SUM(CASE WHEN {CUBE}.shipped_date IS NOT NULL THEN 1 ELSE 0 END), 0)\"\n        type: number\n        format: percent\n      - name: orders\n        title: Orders\n        type: count\n      - name: count\n        title: Row Count\n        type: count"
    },
