{
  "name": "@wechart/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "scripts": {
    "build": "vite build -c vite.build.config.ts",
    "dev": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate -m src/db/migrations"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/session": "11.1.3",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@wechart/core": "workspace:*",
    "@wechart/ui": "workspace:*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "node-pg-migrate": "9.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "pg-boss": "12.33.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.0.0",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
