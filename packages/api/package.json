{
  "name": "@wechart/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build -c vite.build.config.ts",
    "dev": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate -m src/db/migrations"
  },
  "dependencies": {
    "@wechart/core": "workspace:*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.5",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
